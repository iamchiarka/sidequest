# OS
.DS_Store
Thumbs.db

# Editor
.idea/
.vscode/*
!.vscode/extensions.json

# API (Laravel) — most of this is generated by `composer create-project`
/api/vendor/
/api/.env
/api/.env.*
!/api/.env.example
/api/storage/*.key
/api/bootstrap/cache/*.php
/api/node_modules/
/api/public/hot
/api/public/storage
/api/.phpunit.cache/

# Mobile (Flutter) — `flutter create` will add its own, more specific .gitignore
/mobile/build/
/mobile/.dart_tool/
